# Copy this file to `.env` and fill in a random secret string.
# The SAME secret must be set as YT_PROXY_SECRET in your Vercel env vars.
# Generate one: on Windows PowerShell run:  -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 48 | % {[char]$_})
# Or on git-bash / linux:                   openssl rand -hex 32

PROXY_SECRET=change-me-to-a-long-random-string

# Optional — default is 3001
# PORT=3001
