# ===== REQUIRED =====

# PostgreSQL database (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Payload CMS secret — MUST be 64+ random characters for production
# Generate: openssl rand -hex 32
PAYLOAD_SECRET=your-secret-min-64-chars-here-change-this-in-production

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== OPTIONAL: File Storage (Cloudflare R2) =====
# If unset, uploads fall back to local filesystem under public/uploads/
# (dev convenience only — production on Vercel MUST set these, filesystem is read-only)

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ===== OPTIONAL: Payment Gateways =====

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
