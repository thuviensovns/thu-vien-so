6:["$","p",null,{"children":"Điều khoản này được xây dựng căn cứ theo Bộ luật Dân sự 2015; Luật Thương mại 2005; Luật Giao dịch điện tử 2023 (số 20/2023/QH15); Luật Bảo vệ quyền lợi người tiêu dùng 2023 (số 19/2023/QH15); Nghị định 52/2013/NĐ-CP và Nghị định 85/2021/NĐ-CP về thương mại điện tử; Luật Sở hữu trí tuệ 2005 (sửa đổi, bổ sung 2009, 2019, 2022)."}]
7:["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-bold text-foreground mb-3","children":"Điều 1. Thông tin chủ thể cung cấp dịch vụ"}],["$","ul",null,{"className":"list-disc pl-5 space-y-1.5","children":[["$","li",null,{"children":[["$","strong",null,{"className":"text-foreground","children":"Tên nền tảng:"}]," ","Thư Viện Số"]}],["$","li",null,{"children":[["$","strong",null,{"className":"text-foreground","children":"Loại hình:"}]," Nền tảng thương mại điện tử cung cấp sản phẩm số (tài nguyên sản xuất âm nhạc)"]}],["$","li",null,{"children":[["$","strong",null,{"className":"text-foreground","children":"Email liên hệ:"}]," ",["$","a",null,{"href":"mailto:support.thuvienso@gmail.com","className":"text-primary hover:underline","children":"support.thuvienso@gmail.com"}]]}],["$","li",null,{"children":[["$","strong",null,{"className":"text-foreground","children":"Số điện thoại:"}]," ","0898 144 763"]}],["$","li",null,{"children":[["$","strong",null,{"className":"text-foreground","children":"Lĩnh vực hoạt động:"}]," Cung cấp Sample Pack, FLP Project, VST Plugin, Preset, Instrument và các tài nguyên âm nhạc số"]}]]}]]}]
8:["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-bold text-foreground mb-3","children":"Điều 2. Phạm vi và đối tượng áp dụng"}],["$","ol",null,{"className":"list-decimal pl-5 space-y-1.5","children":[["$","li",null,{"children":["Điều khoản này áp dụng cho tất cả người dùng truy cập, đăng ký tài khoản và sử dụng dịch vụ trên nền tảng ","Thư Viện Số","."]}],["$","li",null,{"children":"Bằng việc đăng ký tài khoản hoặc sử dụng dịch vụ, người dùng xác nhận đã đọc, hiểu và đồng ý tuân thủ toàn bộ Điều khoản sử dụng này."}],["$","li",null,{"children":"Người dùng dưới 16 tuổi cần có sự đồng ý của cha, mẹ hoặc người giám hộ hợp pháp theo quy định tại Nghị định 13/2023/NĐ-CP."}]]}]]}]
9:["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-bold text-foreground mb-3","children":"Điều 3. Tài khoản người dùng"}],["$","ol",null,{"className":"list-decimal pl-5 space-y-1.5","children":[["$","li",null,{"children":"Người dùng phải cung cấp thông tin chính xác, đầy đủ khi đăng ký tài khoản theo quy định tại Điều 9 Luật Giao dịch điện tử 2023."}],["$","li",null,{"children":"Người dùng chịu trách nhiệm bảo mật thông tin đăng nhập và mọi hoạt động phát sinh từ tài khoản của mình."}],["$","li",null,{"children":"Mỗi tài khoản chỉ được sử dụng bởi một cá nhân. Nghiêm cấm chia sẻ, mua bán hoặc chuyển nhượng tài khoản."}],["$","li",null,{"children":["Chúng tôi có quyền tạm khóa hoặc chấm dứt tài khoản trong các trường hợp: vi phạm Điều khoản sử dụng, sử dụng dịch vụ vào mục đích vi phạm pháp luật, hoặc có hành vi gian lận. Trước khi khóa tài khoản, chúng tôi sẽ ",["$","strong",null,{"className":"text-foreground","children":"thông báo cho người dùng qua email"}]," và nêu rõ lý do, trừ trường hợp vi phạm nghiêm trọng cần xử lý khẩn cấp theo yêu cầu cơ quan có thẩm quyền."]}],["$","li",null,{"children":"Người dùng có quyền yêu cầu xóa tài khoản bất cứ lúc nào bằng cách liên hệ qua email hoặc trang Liên hệ. Tài khoản sẽ được xóa trong vòng 30 ngày làm việc."}]]}]]}]
a:["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-bold text-foreground mb-3","children":"Điều 4. Sản phẩm và giấy phép sử dụng"}],["$","ol",null,{"className":"list-decimal pl-5 space-y-1.5","children":[["$","li",null,{"children":[["$","strong",null,{"className":"text-foreground","children":"Quyền sở hữu trí tuệ:"}]," Toàn bộ sản phẩm trên nền tảng được bảo hộ theo Luật Sở hữu trí tuệ 2005 (sửa đổi 2022). Người dùng mua sản phẩm được cấp",["$","strong",null,{"className":"text-foreground","children":" quyền sử dụng có giới hạn (license)"}],", không phải quyền sở hữu."]}],["$","li",null,{"children":[["$","strong",null,{"className":"text-foreground","children":"Phạm vi giấy phép:"}],["$","ul",null,{"className":"list-disc pl-5 mt-1.5 space-y-1","children":[["$","li",null,{"children":"Được sử dụng trong sản phẩm âm nhạc cá nhân và thương mại (bài hát, beat, nhạc nền)."}],["$","li",null,{"children":"Được sử dụng trên không giới hạn dự án âm nhạc."}],["$","li",null,{"children":[["$","strong",null,{"className":"text-foreground","children":"Không được"}]," phân phối lại, bán lại, chia sẻ hoặc cho tải lại file gốc dưới bất kỳ hình thức nào."]}],["$","li",null,{"children":[["$","strong",null,{"className":"text-foreground","children":"Không được"}]," sử dụng sản phẩm để tạo sản phẩm cạnh tranh trực tiếp (ví dụ: đóng gói lại thành sample pack khác)."]}]]}]]}],["$","li",null,{"children":"Sản phẩm miễn phí cũng tuân theo điều khoản giấy phép tương tự, trừ khi có ghi chú riêng trên trang sản phẩm."}],["$","li",null,{"children":"Mỗi lần mua cho phép tải tối đa 5 lần trong vòng 72 giờ. Sau thời hạn này, người dùng có thể liên hệ hỗ trợ để được cấp lại quyền tải."}]]}]]}]
b:["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-bold text-foreground mb-3","children":"Điều 5. Giá cả và thanh toán"}],["$","ol",null,{"className":"list-decimal pl-5 space-y-1.5","children":[["$","li",null,{"children":"Giá sản phẩm được niêm yết bằng Việt Nam Đồng (VND), là giá cuối cùng người dùng phải thanh toán."}],["$","li",null,{"children":"Các phương thức thanh toán được hỗ trợ: chuyển khoản ngân hàng qua QR code, VNPay, MoMo."}],["$","li",null,{"children":["Thanh toán được xử lý qua các cổng thanh toán có giấy phép hoạt động tại Việt Nam. ","Thư Viện Số"," không lưu trữ thông tin thẻ ngân hàng của người dùng."]}],["$","li",null,{"children":"Hóa đơn điện tử (nếu có) sẽ được gửi qua email đăng ký theo quy định pháp luật về hóa đơn điện tử."}]]}]]}]
