2d:T972,(function(){try{localStorage.setItem('admin_site_settings',"{\"zalo\":\"\",\"tiktok\":\"https://www.tiktok.com/@thuviensovns\",\"siteUrl\":\"https://thuvienso.top\",\"youtube\":\"https://www.youtube.com/@thuviensovnstop\",\"facebook\":\"https://www.facebook.com/thuviensovns\",\"logoText\":\"Thư Viện Số\",\"minTopup\":10000,\"siteName\":\"Thư Viện Số\",\"telegram\":\"\",\"heroBadge\":\"\",\"heroTitle\":\"Thư Viện Số Việt Nam\",\"metaTitle\":\"Thư Viện Số — Tài nguyên cho Producer Việt\",\"footerText\":\"Tài nguyên FLP, VST, Sample Pack cho Producer Việt Nam. Download miễn phí và premium cho Producer Việt.\",\"contactEmail\":\"support.thuvienso@gmail.com\",\"contactPhone\":\"0898 144 763\",\"heroSubtitle\":\"Download Sample Pack, FLP Project, VST Plugin & Preset chất lượng cao. Tài nguyên EDM, Vinahouse dành riêng cho Producer Việt.\",\"maxDownloads\":5,\"metaKeywords\":\"fl studio, sample pack, vst plugin, flp project, preset, producer việt nam\",\"copyrightText\":\"\",\"sevenTrackFee\":15,\"contactAddress\":\"\",\"metaDescription\":\"Download Sample Pack, FLP Project, VST Plugin & Preset miễn phí và premium cho Producer Việt\",\"siteDescription\":\"Tài nguyên FLP, VST, Sample Pack cho Producer Việt Nam\",\"announcementLink\":\"\",\"announcementText\":\"\",\"announcementEnabled\":true,\"downloadExpiryHours\":72}");localStorage.setItem('admin_category_descriptions',"{\"flp\":\"File project FL Studio hoàn chỉnh, sẵn sàng mở và học hỏi kỹ thuật mixing, mastering từ các producer chuyên nghiệp.\",\"vst\":\"Plugin âm thanh chuyên nghiệp: Synthesizer, Effect, Instrument cho các DAW phổ biến.\",\"preset\":\"Preset chất lượng cao cho Serum, Sylenth1, Massive, Spire và các synth phổ biến khác.\",\"instrument\":\"Nhạc cụ ảo chuyên nghiệp: Guitar, Piano, Violin, Drum và nhiều nhạc cụ khác cho sản xuất âm nhạc.\",\"sample-pack\":\"Bộ sưu tập âm thanh chất lượng cao: Drum Kit, Melody Loop, One-shot, FX và nhiều hơn nữa cho mọi thể loại nhạc.\",\"cai-dat-phan-mem\":\"Dịch vụ cài đặt phần mềm âm nhạc: FL Studio, Ableton, Logic Pro, và các DAW chuyên nghiệp khác.\",\"song-nhac-lyrics\":\"Sóng nhạc, hiệu ứng lyrics video, template karaoke và các tài nguyên cho sản xuất video âm nhạc.\"}");}catch(e){}})();4:["$","html",null,{"lang":"vi","suppressHydrationWarning":true,"children":["$","body",null,{"className":"__variable_75b79f __variable_dd5b2f __variable_3c557b font-sans bg-background text-foreground antialiased","children":[["$","script",null,{"dangerouslySetInnerHTML":{"__html":"$2d"},"suppressHydrationWarning":true}],["$","$L2e",null,{"children":[["$","$26",null,{"fallback":null,"children":[["$","$L2f",null,{}],["$","$L30",null,{}],["$","$L31",null,{}]]}],["$","$L32",null,{}],["$","a",null,{"href":"#main-content","className":"sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-md focus:text-sm","children":"Bỏ qua đến nội dung chính"}],["$","div",null,{"className":"flex min-h-screen flex-col pb-[calc(56px+env(safe-area-inset-bottom,0px))] md:pb-0","children":[["$","header",null,{"className":"sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-lg transition-theme","children":["$","div",null,{"className":"container mx-auto flex h-14 sm:h-16 items-center justify-between gap-2 sm:gap-4 px-4","children":[["$","div",null,{"className":"flex items-center gap-1.5 sm:gap-2","children":[["$","$L33",null,{}],["$","$L34",null,{}]]}],["$","$L35",null,{}],["$","div",null,{"className":"flex items-center gap-0.5 sm:gap-1","children":["$L36","$L37","$L38","$L39"]}]]}]}],"$L3a","$L3b","$L3c","$L3d"]}],"$L3e"]}]]}]}]
